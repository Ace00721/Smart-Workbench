def get_horizontal_zone(u):
    if u < ZONE_SPLITS[0]:
        return "right"
    if u < ZONE_SPLITS[1]:
        return "center"
    return "left"


def classify_inventory_state(tool_name, now, st):
    if (now - st["last_seen"]) > INVENTORY_HOLD_S:
        return "OFF_BENCH"
    expected = TOOL_EXPECTED_ZONE.get(tool_name)
    seen_zone = st.get("zone")
    if expected is None or seen_zone is None:
        return "ON_BENCH"
    if seen_zone == expected:
        return "ON_BENCH"
    return "MISPLACED"


