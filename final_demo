def blend_rect(img, x1, y1, x2, y2, color_bgr, alpha):
    x1, x2 = max(0, min(img.shape[1], int(x1))), max(0, min(img.shape[1], int(x2)))
    y1, y2 = max(0, min(img.shape[0], int(y1))), max(0, min(img.shape[0], int(y2)))
    if x2 <= x1 or y2 <= y1:
        return
    roi = img[y1:y2, x1:x2]
    overlay = np.empty_like(roi)
    overlay[:] = color_bgr
    cv2.addWeighted(overlay, alpha, roi, 1 - alpha, 0, roi)


def draw_panel(img, x, y, w, h, title, subtitle=None):
    blend_rect(img, x, y, x + w, y + h, COLOR_PANEL, 0.97)
    cv2.rectangle(img, (x, y), (x + w, y + h), COLOR_BORDER, 1)
    cv2.putText(img, title, (x + 16, y + 34), cv2.FONT_HERSHEY_SIMPLEX, 0.88, COLOR_TEXT, 2, cv2.LINE_AA)
    if subtitle:
        cv2.putText(img, subtitle, (x + 16, y + 58), cv2.FONT_HERSHEY_SIMPLEX, 0.50, COLOR_SUBTEXT, 1, cv2.LINE_AA)


def draw_chip(img, x, y, text, border_color, text_color=COLOR_TEXT, fill=(18, 30, 48), scale=0.54):
    (tw, th), _ = cv2.getTextSize(text, cv2.FONT_HERSHEY_SIMPLEX, scale, 1)
    px, py = 11, 8
    x2, y2 = x + tw + px * 2, y + th + py * 2
    blend_rect(img, x, y, x2, y2, fill, 0.97)
    cv2.rectangle(img, (x, y), (x2, y2), border_color, 1)
    cv2.putText(img, text, (x + px, y + th + py - 2), cv2.FONT_HERSHEY_SIMPLEX, scale, text_color, 1, cv2.LINE_AA)
    return x2


