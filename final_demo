def draw_notification(img, message, level="info"):
    if not message:
        return
    color = COLOR_YELLOW if level == "warn" else COLOR_RED if level == "error" else COLOR_GREEN if level == "success" else COLOR_GRAY
    h, w = img.shape[:2]
    (tw, _), _ = cv2.getTextSize(message, cv2.FONT_HERSHEY_SIMPLEX, 0.76, 2)
    x1, y2 = (w - tw) // 2 - 24, h - 24
    blend_rect(img, x1, y2 - 48, x1 + tw + 48, y2, (18, 28, 42), 0.98)
    cv2.rectangle(img, (x1, y2 - 48), (x1 + tw + 48, y2), color, 2)
    cv2.putText(img, message, (x1 + 16, y2 - 16), cv2.FONT_HERSHEY_SIMPLEX, 0.76, COLOR_TEXT, 2, cv2.LINE_AA)


def draw_footer(img):
    h, w = img.shape[:2]
    blend_rect(img, 0, h - 34, w, h, COLOR_PANEL_ALT, 0.98)
    cv2.line(img, (0, h - 34), (w, h - 34), COLOR_BORDER, 1)
    cv2.putText(img, "ESC quit   TAB select   ENTER lock   A auto   L toggle lock   S search   Voice: say 'Forge', pause, then speak command", (16, h - 11), cv2.FONT_HERSHEY_SIMPLEX, 0.49, COLOR_SUBTEXT, 1, cv2.LINE_AA)


def build_dashboard(screen_w, screen_h, tool_state, counts, last_command, last_response,
                    mode, selected_idx, locked_name, laser_on, drawer_open, cabinet_open,
                    voice_on, awake, fps, system_log, search_active, search_text, toast_message, toast_level,
                    drawer_memory=None, cabinet_memory=None):
    canvas = np.zeros((screen_h, screen_w, 3), dtype=np.uint8)
    canvas[:] = COLOR_BG

    draw_header(canvas, mode, locked_name, laser_on, drawer_open, cabinet_open, voice_on, fps)

    margin, top_y, bottom_reserved = 16, 100, 48
    left_w = right_w = 420
    center_w = screen_w - left_w - right_w - margin * 4
    top_h = max(520, screen_h - top_y - bottom_reserved - margin - 220)
    bottom_h = screen_h - top_y - bottom_reserved - margin - top_h - margin

    draw_command_center(canvas, (margin, top_y, left_w, top_h), counts, last_command, last_response, awake, mode, locked_name, drawer_open, cabinet_open, laser_on)
    draw_bench_map(canvas, (margin * 2 + left_w, top_y, center_w, top_h), tool_state, FIXED_TOOL_ORDER[selected_idx] if 0 <= selected_idx < len(FIXED_TOOL_ORDER) else None)
    draw_inventory_panel(canvas, (screen_w - margin - right_w, top_y, right_w, top_h), tool_state, selected_idx, mode, locked_name)
    draw_log_panel(canvas, (margin * 2 + left_w, top_y + top_h + margin, center_w, bottom_h), system_log)

    if drawer_memory is not None and cabinet_memory is not None:
        draw_storage_indicators(canvas, drawer_memory, cabinet_memory)
    if search_active:
        draw_search_box(canvas, search_text)
    if toast_message:
        draw_notification(canvas, toast_message, toast_level)
    draw_footer(canvas)
    return canvas


