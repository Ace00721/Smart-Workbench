def downsample_48k_to_16k(raw_bytes: bytes) -> bytes:
    samples = np.frombuffer(raw_bytes, dtype=np.int16)
    # mono_samples = samples.reshape(-1, 2)[:, 0]
    return samples[::3].tobytes()


def canonicalize_tool_name(text):
    q = normalize_name(text)
    if q in SEARCH_ALIASES:
        return SEARCH_ALIASES[q]
    q2 = q.replace(" ", "_")
    if q2 in FIXED_TOOL_ORDER:
        return q2
    return None


def extract_tool_from_text(text):
    text_n = normalize_name(text)
    for alias in sorted(SEARCH_ALIASES.keys(), key=len, reverse=True):
        if alias in text_n:
            return SEARCH_ALIASES[alias]
    collapsed = text_n.replace(" ", "_")
    for nm in FIXED_TOOL_ORDER:
        if nm.replace("_", " ") in text_n or nm in collapsed:
            return nm
    return None


def parse_voice_command(text, is_awake):
    t = normalize_name(text)
    if not t:
        return ("none", None)

    wake_words = [
        "hey forge", "hey ford", "hey george", "hey board",
        "hey porch", "hey gorge", "hey fort", "a forge",
        "forge", "forage", "ford", "george", "board",
        "porch", "gorge", "fort", "forged", "porridge", "storage"
    ]

    matched_wake = next((w for w in wake_words if t == w or t.startswith(w + " ")), None)
    if matched_wake is not None:
        t = t[len(matched_wake):].strip()
        current_awake = True
    else:
        current_awake = is_awake

    if not t and current_awake:
        return ("wake_only", None)
    if not current_awake:
        return ("none", None)

    if any(x in t for x in ["quit", "exit", "close program"]):
        return ("quit", None)
    if any(x in t for x in ["what do you see", "visible tools", "inventory"]):
        return ("summary", None)
    if "status" in t:
        return ("status", None)

    if any(x in t for x in ["auto", "auto mode", "otto", "otto mode", "ought to", "out to", "alto", "arturo"]):
        return ("auto", None)

    if any(x in t for x in ["unlock", "clear lock", "stop locking"]):
        return ("unlock", None)
    if any(x in t for x in ["find", "lock", "track", "point to", "point at", "select", "where is"]):
        tool = extract_tool_from_text(t)
        if tool is not None:
            return ("lock_tool", tool)

    tool = canonicalize_tool_name(t)
    if tool is not None:
        return ("lock_tool", tool)

    return ("unknown_after_wake", t)


def voice_audio_callback(indata, frames, time_info, status):
    try:
        voice_audio_queue.put_nowait(bytes(indata))
    except queue.Full:
        pass


def voice_listener_worker():
    try:
        vosk_model = VoskModel(VOSK_MODEL_PATH)
        rec = KaldiRecognizer(vosk_model, VOICE_TARGET_RATE)
        rec.SetWords(False)

        with sd.RawInputStream(
            samplerate=VOICE_INPUT_RATE, blocksize=VOICE_BLOCKSIZE,
            device=VOICE_DEVICE, dtype="int16", channels=1,
            callback=voice_audio_callback,
        ):
            print("[VOICE] Listening...")
            while True:
                data_48k = voice_audio_queue.get()
                if data_48k is None:
                    break
                if rec.AcceptWaveform(downsample_48k_to_16k(data_48k)):
                    text = normalize_name(json.loads(rec.Result()).get("text", ""))
                    if text:
                        print(f"[VOICE RAW] {text}")
                        voice_command_queue.put(text)
                else:
                    _ = rec.PartialResult()
    except Exception as e:
        print(f"[VOICE] Failed to start: {e}")


