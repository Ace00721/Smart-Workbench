    cv2.putText(img, "RIGHT", (col2 + 44, map_y1 + 34), cv2.FONT_HERSHEY_SIMPLEX, 0.70, COLOR_CYAN, 2, cv2.LINE_AA)

    zone_center_x = {"left": (map_x1 + col1) // 2, "center": (col1 + col2) // 2, "right": (col2 + map_x2) // 2}
    visible_tools = [nm for nm in FIXED_TOOL_ORDER if tool_state[nm]["state"] != "OFF_BENCH"]
    vertical_spacing = max(70, (map_y2 - map_y1 - 120) // max(1, len(visible_tools)))
    zone_counts = {"left": 0, "center": 0, "right": 0}
    base_y = map_y1 + 96

    for nm in FIXED_TOOL_ORDER:
        st = tool_state[nm]
        if st["state"] == "OFF_BENCH":
            continue
        zone = st.get("zone", "center") if st.get("zone") in zone_center_x else "center"
        cx, cy = zone_center_x[zone], base_y + zone_counts[zone] * vertical_spacing
        zone_counts[zone] += 1

        color = inventory_state_color(st["state"])
        radius = 14 if nm != selected_name else 18
        cv2.circle(img, (cx, cy), radius, color, -1, cv2.LINE_AA)
        cv2.circle(img, (cx, cy), radius + 6, (220, 238, 255), 1, cv2.LINE_AA)

        label = f"{pretty_tool_name(nm)} [{zone}]"
        lx1, ly1, lx2, ly2 = min(map_x2 - 190, cx + 18), cy - 16, min(map_x2 - 190, cx + 18) + 178, cy + 16
        blend_rect(img, lx1, ly1, lx2, ly2, (20, 34, 52), 0.99)
        cv2.rectangle(img, (lx1, ly1), (lx2, ly2), color, 1)
        cv2.putText(img, label[:24], (lx1 + 8, cy + 5), cv2.FONT_HERSHEY_SIMPLEX, 0.46, COLOR_TEXT, 1, cv2.LINE_AA)

    draw_chip(img, x + 24, y + h - 56, "ON BENCH", COLOR_GREEN, scale=0.46)
    draw_chip(img, x + 152, y + h - 56, "MISPLACED", COLOR_YELLOW, scale=0.46)
    draw_chip(img, x + 300, y + h - 56, "OFF BENCH", COLOR_OFF, scale=0.46)


def draw_inventory_panel(img, rect, tool_state, selected_idx, mode, locked_name):
    x, y, w, h = rect
    draw_panel(img, x, y, w, h, "Inventory", "Current tool states")
    row_h, start_y = 66, y + 88

    for i, name in enumerate(FIXED_TOOL_ORDER[:min(len(FIXED_TOOL_ORDER), max(1, (h - 160) // row_h))]):
        st = tool_state[name]
        state, conf = st["state"], float(st["conf"])
        yy = start_y + i * row_h

        fill, border = (17, 30, 48), (52, 74, 112)
        if mode == "LOCK" and locked_name == name:
            fill, border = (28, 50, 74), COLOR_CYAN
        elif i == selected_idx:
            fill, border = (22, 36, 58), (120, 144, 190)

        blend_rect(img, x + 12, yy - 24, x + w - 12, yy + 30, fill, 0.98)
        cv2.rectangle(img, (x + 12, yy - 24), (x + w - 12, yy + 30), border, 1)
        cv2.putText(img, pretty_tool_name(name), (x + 24, yy + 2), cv2.FONT_HERSHEY_SIMPLEX, 0.72, inventory_state_text_color(state), 2 if state != "OFF_BENCH" else 1, cv2.LINE_AA)

        bar_x1, bar_y1, bar_w, bar_h = x + 24, yy + 12, 170, 8
        cv2.rectangle(img, (bar_x1, bar_y1), (bar_x1 + bar_w, bar_y1 + bar_h), (48, 54, 64), -1)
        if state != "OFF_BENCH":
            cv2.rectangle(img, (bar_x1, bar_y1), (bar_x1 + int(bar_w * clamp(conf, 0.0, 1.0)), bar_y1 + bar_h), inventory_state_color(state), -1)
        cv2.rectangle(img, (bar_x1, bar_y1), (bar_x1 + bar_w, bar_y1 + bar_h), (78, 86, 98), 1)

        draw_chip(img, x + 218, yy - 16, state, inventory_state_color(state), scale=0.44)
        detail = f"zone:{st.get('zone', '-')}" + (f"   exp:{TOOL_EXPECTED_ZONE.get(name, '-')}" if state == "MISPLACED" else f"   conf:{conf:.2f}" if state == "ON_BENCH" else "")
        cv2.putText(img, detail[:24], (x + 218, yy + 18), cv2.FONT_HERSHEY_SIMPLEX, 0.46, COLOR_SUBTEXT, 1, cv2.LINE_AA)

    counts = {
        "on_bench": sum(1 for nm in FIXED_TOOL_ORDER if tool_state[nm]["state"] == "ON_BENCH"),
        "misplaced": sum(1 for nm in FIXED_TOOL_ORDER if tool_state[nm]["state"] == "MISPLACED"),
        "off_bench": sum(1 for nm in FIXED_TOOL_ORDER if tool_state[nm]["state"] == "OFF_BENCH"),
    }
    base_y = y + h - 74
    draw_chip(img, x + 16, base_y, f"TOTAL {len(FIXED_TOOL_ORDER)}", COLOR_ACCENT, scale=0.48)
    draw_chip(img, x + 128, base_y, f"ON {counts['on_bench']}", COLOR_GREEN, scale=0.48)
    draw_chip(img, x + 220, base_y, f"MIS {counts['misplaced']}", COLOR_YELLOW, scale=0.48)
    draw_chip(img, x + 330, base_y, f"OFF {counts['off_bench']}", COLOR_OFF, scale=0.48)


