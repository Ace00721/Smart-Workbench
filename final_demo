def main():
    pwm_pan = None
    pwm_tilt = None
    picam2 = None
    voice_thread = None
    pca = None

    try:
        # Hardware init
        GPIO.setup(PIN_LASER, GPIO.OUT)
        GPIO.output(PIN_LASER, GPIO.LOW)

        # PCA9685 I2C SETUP
        try:
            i2c = busio.I2C(board.SCL, board.SDA)
            pca = PCA9685(i2c)
            pca.frequency = 50

            # Map channels (Pan = 0, Tilt = 1)
            CHANNEL_PAN = 0
            CHANNEL_TILT = 1
        except Exception as e:
            print(f"[ERROR] PCA9685 failed to initialize. Check I2C wiring! Error: {e}")
            pca = None

        # Restore original DebouncedInput hardware polling
        drawer_in = DebouncedInput(PIN_DRAWER, pull=GPIO.PUD_UP, debounce_s=REED_DEBOUNCE_S)
        cabinet_in = DebouncedInput(PIN_CABINET, pull=GPIO.PUD_UP, debounce_s=REED_DEBOUNCE_S)

        model = YOLO(MODEL_PATH)

        def class_name_from_id(cls_id: int) -> str:
            if isinstance(model.names, dict):
                return str(model.names.get(cls_id, cls_id))
            return str(model.names[cls_id])

        name_to_id = {normalize_name(str(v)).replace(" ", "_"): int(k) for k, v in (model.names.items() if isinstance(model.names, dict) else enumerate(model.names))}
        yolo_conf_floor = min([CONF_THRESH_GLOBAL] + list(CONF_THRESH_BY_NAME.values()))

        u_list, v_list, pv = load_grid(CALIB_JSON)
        print(f"[OK] Loaded calibration grid from {CALIB_JSON}")

        picam2 = Picamera2()
        picam2.configure(picam2.create_video_configuration(main={"size": FRAME_SIZE, "format": "RGB888"}, transform=Transform(hflip=1, vflip=1)))
        picam2.start()
        time.sleep(1.0)
        frame_w, frame_h = FRAME_SIZE

        cv2.namedWindow(WINDOW_NAME, cv2.WINDOW_NORMAL)
        cv2.setWindowProperty(WINDOW_NAME, cv2.WND_PROP_FULLSCREEN, cv2.WINDOW_FULLSCREEN)
        screen_w, screen_h = DEFAULT_SCREEN_W, DEFAULT_SCREEN_H
        screen_size_locked = False

        center_pan, center_tilt = map_xy_to_pan_tilt(frame_w / 2.0, frame_h / 2.0, frame_w, frame_h, u_list, v_list, pv)
        current_pan, current_tilt = clamp(center_pan, PAN_MIN, PAN_MAX), clamp(center_tilt, TILT_MIN, TILT_MAX)
        if pca:
            set_servo_angle(pca, CHANNEL_PAN, current_pan)
            set_servo_angle(pca, CHANNEL_TILT, current_tilt)

        if VOICE_ENABLED:
            threading.Thread(target=voice_listener_worker, daemon=True).start()

        # Runtime state
        ema_x, ema_y = None, None
        last_det_time, last_servo_update = 0.0, 0.0
        mode, selected_idx, locked_name, locked_cls_id, last_locked_seen_time = "AUTO", 0, None, None, 0.0
        auto_target_cls_id, auto_target_last_seen, auto_target_last_switch, auto_target_conf = None, 0.0, 0.0, 0.0
        toast_msg, toast_level, toast_until = "", "info", 0.0
        awake, awake_timeout = False, 0.0

        system_log = deque(maxlen=8)
        add_log(system_log, "System initialized successfully")

        last_command_text = ""
        last_response_text = "System ready. Awaiting command."
        speak_response(last_response_text)

        tool_state = {nm: {"present": False, "conf": 0.0, "last_seen": 0.0, "zone": None, "state": "OFF_BENCH", "prev_state": "OFF_BENCH"} for nm in FIXED_TOOL_ORDER}
        search_active, search_text = False, ""
        last_time, fps = time.time() - 0.1, 0.0

        drawer_tool_memory = {nm: False for nm in FIXED_TOOL_ORDER}
        drawer_missing_candidates = set()
        cabinet_tool_memory = {nm: False for nm in FIXED_TOOL_ORDER}
        cabinet_missing_candidates = set()

        def drawer_aware_response(tool_name):
            if drawer_tool_memory.get(tool_name, False):
                return f"{pretty_tool_name(tool_name)} is placed in the drawer."
            if cabinet_tool_memory.get(tool_name, False):
                return f"{pretty_tool_name(tool_name)} is placed in the cabinet."
            return generate_response_for_lock(tool_name, tool_state)

        prev_drawer_open = None
        prev_cabinet_open = None

        def set_toast(msg, level="info", seconds=1.2, log_it=True):
            nonlocal toast_msg, toast_level, toast_until
            toast_msg, toast_level, toast_until = msg, level, time.time() + seconds
            if log_it:
                add_log(system_log, msg)

        print("[INFO] F.O.R.G.E. started. ESC quit, TAB select, ENTER lock, A auto, S search")

        while True:
            frame = picam2.capture_array()
            now = time.time()
            fps = 1.0 / (now - last_time) if fps <= 0 else (0.85 * fps + 0.15 * (1.0 / (now - last_time)))
            last_time = now

            if awake and now > awake_timeout:
                awake = False
                last_response_text = "Wake timeout elapsed."
                set_toast("F.O.R.G.E. went back to sleep", "info", 1.0)
                speak_response("Sleeping")

            while not voice_command_queue.empty():
                spoken = voice_command_queue.get().strip()
                last_command_text = spoken
                add_log(system_log, f"Voice heard: {spoken}")
                cmd, arg = parse_voice_command(spoken, awake)

                if cmd == "wake_only":
                    awake = True
                    awake_timeout = now + 3.0
                    last_response_text = "Listening for your command."
                    set_toast("Listening...", "success", 1.8, log_it=False)
                    speak_response("Yes?")
                    continue
                if cmd == "none":
                    continue
                awake = False

                if cmd == "lock_tool":
                    cls_id = name_to_id.get(arg)
                    if cls_id is None:
                        last_response_text = f"{pretty_tool_name(arg)} is not in the current model."
                        set_toast(f"Voice tool not in model: {arg}", "error", 1.4)
                        speak_response(last_response_text)
                    else:
                        mode, locked_name, locked_cls_id, last_locked_seen_time = "LOCK", arg, cls_id, now
                        if arg in FIXED_TOOL_ORDER:
                            selected_idx = FIXED_TOOL_ORDER.index(arg)
                        last_response_text = drawer_aware_response(arg)
                        set_toast(f"Tracking {pretty_tool_name(locked_name)}", "success", 1.1)
                        speak_response(last_response_text)

                elif cmd == "auto":
                    mode, locked_name, locked_cls_id = "AUTO", None, None
                    last_response_text = "Switched to auto mode."
                    set_toast("AUTO mode enabled", "info", 1.0)
                    speak_response(last_response_text)

                elif cmd == "unlock":
                    mode, locked_name, locked_cls_id = "AUTO", None, None
                    last_response_text = "Lock cleared."
                    set_toast("Lock cleared", "info", 1.0)
                    speak_response(last_response_text)

                elif cmd == "summary":
                    visible = [pretty_tool_name(nm) for nm in FIXED_TOOL_ORDER if tool_state[nm]["state"] != "OFF_BENCH"]
                    if visible:
                        last_response_text = "Visible tools: " + ", ".join(visible[:4])
                        set_toast("Visible: " + ", ".join(visible[:4]), "info", 1.4, log_it=False)
                    else:
                        last_response_text = "No tools are currently visible."
                        set_toast("No tools visible", "warn", 1.2, log_it=False)
                    speak_response(last_response_text)

                elif cmd == "status":
                    d = "open" if prev_drawer_open else "closed"
                    c = "open" if prev_cabinet_open else "closed"
                    last_response_text = f"Drawer is {d}. Cabinet is {c}."
                    set_toast(f"Drawer {d}, cabinet {c}", "info", 1.3, log_it=False)
                    speak_response(last_response_text)

                elif cmd == "quit":
                    last_response_text = "Quitting system."
                    set_toast("Quitting system", "warn", 0.8)
                    speak_response(last_response_text)
                    raise KeyboardInterrupt

                elif cmd == "unknown_after_wake":
                    last_response_text = f"Unknown command: {arg}."
                    set_toast(f"Unknown command: {arg}", "warn", 1.1)
                    speak_response(last_response_text)

            # Reverted back to original polled hardware checks
            drawer_level = drawer_in.read()
            cabinet_level = cabinet_in.read()
            drawer_open = reed_state_to_open(drawer_level, low_means_closed=DRAWER_LOW_MEANS_CLOSED)
            cabinet_open = reed_state_to_open(cabinet_level, low_means_closed=CABINET_LOW_MEANS_CLOSED)

            if prev_drawer_open is None:
                prev_drawer_open = drawer_open
            if prev_cabinet_open is None:
                prev_cabinet_open = cabinet_open

            drawer_just_closed = (prev_drawer_open is True and drawer_open is False)
            cabinet_just_closed = (prev_cabinet_open is True and cabinet_open is False)

            if drawer_open != prev_drawer_open:
                msg = "Drawer opened" if drawer_open else "Drawer closed"
                set_toast(msg, "info", 1.0)
                speak_response(msg)
                prev_drawer_open = drawer_open

            if cabinet_open != prev_cabinet_open:
                msg = "Cabinet opened" if cabinet_open else "Cabinet closed"
                set_toast(msg, "info", 1.0)
                speak_response(msg)
                prev_cabinet_open = cabinet_open

            # YOLO Detection
            r = model(frame, imgsz=INFER_SIZE, conf=yolo_conf_floor, verbose=False)[0]
            best_by_cls, best_overall = {}, None

            if r.boxes is not None and len(r.boxes):
                for box in r.boxes:
                    conf, cls_id = float(box.conf[0]), int(box.cls[0])
                    name_norm = normalize_name(str(class_name_from_id(cls_id))).replace(" ", "_")
                    if conf < CONF_THRESH_BY_NAME.get(name_norm, CONF_THRESH_GLOBAL):
                        continue
                    x1, y1, x2, y2 = box.xyxy[0].tolist()
                    cx, cy = (x1 + x2) / 2.0, (y1 + y2) / 2.0
                    if best_overall is None or conf > best_overall[0]:
                        best_overall = (conf, cx, cy, name_norm, cls_id)
                    if cls_id not in best_by_cls or conf > best_by_cls[cls_id][0]:
                        best_by_cls[cls_id] = (conf, cx, cy, name_norm)

            for nm in FIXED_TOOL_ORDER:
                tool_state[nm]["present"] = False

            for cls_id, (conf, cx, cy, nm) in best_by_cls.items():
                if nm in tool_state:
                    tool_state[nm].update({"conf": conf, "last_seen": now, "present": True, "zone": get_horizontal_zone(clamp(cx / float(frame_w), 0.0, 1.0))})

            for nm, st in tool_state.items():
                age = now - st["last_seen"] if st["last_seen"] > 0 else 1e9
                st["present"] = (st["last_seen"] > 0 and age <= PRESENCE_HOLD_S)
                if age > INVENTORY_HOLD_S:
                    st.update({"conf": 0.0, "zone": None})
                st["prev_state"], st["state"] = st["state"], classify_inventory_state(nm, now, st)

                if MISPLACED_TOASTS and st["state"] != st["prev_state"]:
                    if st["state"] == "MISPLACED":
                        set_toast(f"{pretty_tool_name(nm)} misplaced", "warn", 1.0)
                    elif st["state"] == "OFF_BENCH" and st["prev_state"] != "OFF_BENCH":
                        set_toast(f"{pretty_tool_name(nm)} off bench", "info", 0.9)
                    elif st["state"] == "ON_BENCH" and st["prev_state"] != "ON_BENCH":
                        set_toast(f"{pretty_tool_name(nm)} on bench", "success", 0.9)

            # Drawer memory feature:
            # Track tools that disappear while drawer is open.
            if drawer_open:
                for nm in FIXED_TOOL_ORDER:
                    st = tool_state[nm]
                    if st["prev_state"] != "OFF_BENCH" and st["state"] == "OFF_BENCH":
                        drawer_missing_candidates.add(nm)

            if drawer_just_closed:
                stored_tools = []
                for nm in list(drawer_missing_candidates):
                    if tool_state[nm]["state"] == "OFF_BENCH" and not cabinet_tool_memory.get(nm, False):
                        drawer_tool_memory[nm] = True
                        cabinet_tool_memory[nm] = False
                        cabinet_missing_candidates.discard(nm)
                        stored_tools.append(nm)

                if stored_tools:
                    pretty_names = ", ".join(pretty_tool_name(nm) for nm in stored_tools)
                    last_response_text = f"Stored in drawer: {pretty_names}."
                    set_toast(f"Stored in drawer: {pretty_names}", "info", 1.4)
                    speak_response(last_response_text)

                drawer_missing_candidates.clear()

            # Cabinet memory feature:
            # Track tools that disappear while cabinet is open.
            if cabinet_open:
                for nm in FIXED_TOOL_ORDER:
                    st = tool_state[nm]
                    if st["prev_state"] != "OFF_BENCH" and st["state"] == "OFF_BENCH":
                        cabinet_missing_candidates.add(nm)

            if cabinet_just_closed:
                stored_tools = []
                for nm in list(cabinet_missing_candidates):
                    if tool_state[nm]["state"] == "OFF_BENCH" and not drawer_tool_memory.get(nm, False):
                        cabinet_tool_memory[nm] = True
                        drawer_tool_memory[nm] = False
                        drawer_missing_candidates.discard(nm)
                        stored_tools.append(nm)

                if stored_tools:
                    pretty_names = ", ".join(pretty_tool_name(nm) for nm in stored_tools)
                    last_response_text = f"Stored in cabinet: {pretty_names}."
                    set_toast(f"Stored in cabinet: {pretty_names}", "info", 1.4)
                    speak_response(last_response_text)

                cabinet_missing_candidates.clear()

            # Clear memory if tool reappears.
            for nm in FIXED_TOOL_ORDER:
                if tool_state[nm]["state"] != "OFF_BENCH":
                    drawer_tool_memory[nm] = False
                    cabinet_tool_memory[nm] = False
                    drawer_missing_candidates.discard(nm)
                    cabinet_missing_candidates.discard(nm)

            # Target Selection
            best = None
            if mode == "LOCK" and locked_cls_id is not None:
                if locked_cls_id in best_by_cls:
                    best = (*best_by_cls[locked_cls_id], locked_cls_id)
            elif best_overall is not None:
                new_conf, new_cx, new_cy, new_nm, new_id = best_overall
                current_conf = best_by_cls[auto_target_cls_id][0] if auto_target_cls_id in best_by_cls else 0.0
                if auto_target_cls_id is not None and auto_target_cls_id in best_by_cls:
                    auto_target_last_seen = now
                elif auto_target_cls_id is not None and (now - auto_target_last_seen) > AUTO_TARGET_GRACE_S:
                    auto_target_cls_id = None

                if auto_target_cls_id is None or ((now - auto_target_last_switch) >= AUTO_SWITCH_HOLD_S and new_id != auto_target_cls_id and new_conf >= auto_target_conf + AUTO_SWITCH_MARGIN):
                    auto_target_cls_id, auto_target_conf, auto_target_last_seen, auto_target_last_switch = new_id, new_conf, now, now
                elif auto_target_cls_id in best_by_cls:
                    auto_target_conf = current_conf

                if auto_target_cls_id in best_by_cls:
                    best = (*best_by_cls[auto_target_cls_id], auto_target_cls_id)

            # Laser Control
            laser_state = GPIO.input(PIN_LASER) == GPIO.HIGH
            if mode == "LOCK" and locked_cls_id is not None:
                if best is not None:
                    last_locked_seen_time = last_det_time = now
                    GPIO.output(PIN_LASER, GPIO.HIGH)
                    laser_state = True
                elif (now - last_locked_seen_time) > LOCK_LOST_TIMEOUT:
                    GPIO.output(PIN_LASER, GPIO.LOW)
                    laser_state, ema_x, ema_y = False, None, None
            else:
                if best is not None:
                    last_det_time = now
                    GPIO.output(PIN_LASER, GPIO.HIGH)
                    laser_state = True
                elif (now - last_det_time) > NO_DET_TIMEOUT:
                    GPIO.output(PIN_LASER, GPIO.LOW)
                    laser_state, ema_x, ema_y = False, None, None

            # Pi Hardware PWM Servo Update
            if best is not None and pca:
                conf, cx, cy, nm, cls_id = best
                ema_x = cx if ema_x is None else EMA_ALPHA * cx + (1.0 - EMA_ALPHA) * ema_x
                ema_y = cy if ema_y is None else EMA_ALPHA * cy + (1.0 - EMA_ALPHA) * ema_y

                if (now - last_servo_update) >= SERVO_UPDATE_PERIOD:
                    target_pan, target_tilt = map_xy_to_pan_tilt(ema_x, ema_y, frame_w, frame_h, u_list, v_list, pv)
                    moved = False
                    if abs(target_pan - current_pan) >= DEADBAND_DEG:
                        current_pan = target_pan
                        set_servo_angle(pca, CHANNEL_PAN, current_pan)
                        moved = True
                    if abs(target_tilt - current_tilt) >= DEADBAND_DEG:
                        current_tilt = target_tilt
                        set_servo_angle(pca, CHANNEL_TILT, current_tilt)
                        moved = True
                    if moved:
                        last_servo_update = now

            if locked_name and mode == "LOCK":
                last_response_text = drawer_aware_response(locked_name)

            counts = {
                "on_bench": sum(1 for nm in FIXED_TOOL_ORDER if tool_state[nm]["state"] == "ON_BENCH"),
                "misplaced": sum(1 for nm in FIXED_TOOL_ORDER if tool_state[nm]["state"] == "MISPLACED"),
                "off_bench": sum(1 for nm in FIXED_TOOL_ORDER if tool_state[nm]["state"] == "OFF_BENCH"),
            }

            dashboard = build_dashboard(
                screen_w, screen_h, tool_state, counts, last_command_text, last_response_text,
                mode, selected_idx, locked_name, laser_state, drawer_open, cabinet_open,
                VOICE_ENABLED, awake, fps, system_log, search_active, search_text,
                toast_msg if time.time() < toast_until else "", toast_level,
                drawer_tool_memory, cabinet_tool_memory
            )

            cv2.imshow(WINDOW_NAME, dashboard)
            key = cv2.waitKey(1) & 0xFF

            if key == 27:
                if search_active:
                    search_active, search_text = False, ""
                    set_toast("Search cancelled", "warn", 0.9)
                else:
                    break
            elif search_active:
                if key in (10, 13):
                    q = normalize_name(search_text)
                    canonical = SEARCH_ALIASES.get(q, q.replace(" ", "_") if q.replace(" ", "_") in FIXED_TOOL_ORDER else None)
                    if canonical is None:
                        last_response_text = f"Unknown tool: {search_text}."
                        set_toast(f"Unknown tool: {search_text}", "warn", 1.2)
                        speak_response(last_response_text)
                    else:
                        locked_name, locked_cls_id = canonical, name_to_id.get(canonical)
                        if locked_cls_id is None:
                            last_response_text = f"{pretty_tool_name(canonical)} is not in the model."
                            set_toast(f"Tool '{canonical}' not in model", "error", 1.4)
                            speak_response(last_response_text)
                            mode, locked_name, locked_cls_id = "AUTO", None, None
                        else:
                            mode, last_locked_seen_time = "LOCK", now
                            last_response_text = drawer_aware_response(canonical)
                            set_toast(f"Lock: {pretty_tool_name(canonical)}", "success", 1.0)
                            speak_response(last_response_text)
                            if canonical in FIXED_TOOL_ORDER:
                                selected_idx = FIXED_TOOL_ORDER.index(canonical)
                    search_active, search_text = False, ""
                elif key in (8, 127):
                    search_text = search_text[:-1]
                elif 32 <= key <= 126 and (chr(key).isalnum() or chr(key) in " _-"):
                    search_text += chr(key)
            elif key == 9:
                selected_idx = (selected_idx + 1) % len(FIXED_TOOL_ORDER)
            elif key in (10, 13):
                nm, cls_id = FIXED_TOOL_ORDER[selected_idx], name_to_id.get(FIXED_TOOL_ORDER[selected_idx])
                if cls_id is None:
                    last_response_text = f"{pretty_tool_name(nm)} is not in the model."
                    set_toast(f"Tool '{nm}' not in model", "error", 1.4)
                    speak_response(last_response_text)
                else:
                    mode, locked_name, locked_cls_id, last_locked_seen_time = "LOCK", nm, cls_id, now
                    last_response_text = drawer_aware_response(nm)
                    set_toast(f"Lock: {pretty_tool_name(nm)}", "success", 1.0)
                    speak_response(last_response_text)
            elif key in (ord('a'), ord('A')):
                mode, locked_name, locked_cls_id, last_response_text = "AUTO", None, None, "Switched to auto mode."
                set_toast("AUTO mode", "info", 1.0)
                speak_response(last_response_text)
            elif key in (ord('s'), ord('S')):
                search_active, search_text = True, ""
                set_toast("Search mode enabled", "info", 1.0)
            elif key in (ord('l'), ord('L')):
                if mode == "LOCK":
                    mode, locked_name, locked_cls_id, last_response_text = "AUTO", None, None, "Lock cleared."
                    set_toast("AUTO mode", "info", 1.0)
                    speak_response(last_response_text)
                else:
                    nm, cls_id = FIXED_TOOL_ORDER[selected_idx], name_to_id.get(FIXED_TOOL_ORDER[selected_idx])
                    if cls_id is not None:
                        mode, locked_name, locked_cls_id, last_locked_seen_time = "LOCK", nm, cls_id, now
                        last_response_text = drawer_aware_response(nm)
                        set_toast(f"Lock: {pretty_tool_name(nm)}", "success", 1.0)
                        speak_response(last_response_text)

    finally:
        try:
            GPIO.output(PIN_LASER, GPIO.LOW)
        except Exception:
            pass
        try:
            voice_audio_queue.put_nowait(None)
        except Exception:
            pass
        if voice_thread and voice_thread.is_alive():
            voice_thread.join(timeout=2.0)

        # Stop PCA9685 safely
        if pca:
            try:
                pca.deinit()
            except Exception:
                pass

        try:
            GPIO.cleanup()
            cv2.destroyAllWindows()
        except Exception:
            pass
        if picam2:
            try:
                picam2.stop()
            except Exception:
                pass


if __name__ == "__main__":
    main()
