def generate_response_for_lock(tool_name, tool_state):
    st = tool_state.get(tool_name)
    if not st:
        return f"{pretty_tool_name(tool_name)} is unavailable."
    state, zone = st.get("state", "OFF_BENCH"), st.get("zone")

    if state == "ON_BENCH":
        return f"{pretty_tool_name(tool_name)} is on the {zone} side of the bench." if zone else f"{pretty_tool_name(tool_name)} is on the bench."
    if state == "MISPLACED":
        return f"{pretty_tool_name(tool_name)} is visible in the {zone or 'unknown'} zone, but expected in the {TOOL_EXPECTED_ZONE.get(tool_name, 'unknown')} zone."
    return f"{pretty_tool_name(tool_name)} is currently off bench."


